watch_file pixi.lock
# `cuda` is a superset of the default environment; rust-analyzer (Zed) checks with
# --all-features, so it needs nvcc and the CUDA libraries.
eval "$(pixi shell-hook -e cuda)"

# candle-flash-attn panics if this directory does not exist
mkdir -p "$CANDLE_FLASH_ATTN_BUILD_DIR"

if [ -d "$HOME/.cargo/bin" ] ; then
    export PATH="$PATH:$HOME/.cargo/bin:"
fi

# TODO remove from here
cargo install cargo-edit
